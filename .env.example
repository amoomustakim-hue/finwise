# Copy to .env.local for local dev. Never commit real values.
# Neon variables are written by `neon deploy` / `neon env pull`.

# Neon Postgres (pooled URL used by the app; unpooled for migrations/tools)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Groq (AI categorisation fallback, statement extraction, insight wording)
GROQ_API_KEY=

# Mono (optional; only when the Mono connection is enabled)
MONO_PUBLIC_KEY=
MONO_SECRET_KEY=
MONO_WEBHOOK_SECRET=
